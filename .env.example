# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Open-Meteo does not require an API key.

DB_ENGINE=postgresql
POSTGRES_DB=looksy
POSTGRES_USER=looksy
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional local ONNX clothing classifier; see docs/stage-3.md.
CLOTHING_ONNX_MODEL=
CLOTHING_ONNX_LABELS=
# U2NET_HOME defaults to backend/.models

# Optional local AI. Only loopback HTTP endpoints are accepted.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=30

# Browser origins for the Next.js session/CSRF flow.
# Production: replace these with the real HTTPS origin; DEBUG=false.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
